# Copy to `.env` in the project root (loaded automatically by `just` recipes).
# Get an API key from TypeSafe: https://typesafe.ai

# Required for examples and live API calls.
TYPESAFE_API_KEY=ts_your_key_here

# Optional overrides (client defaults match the official TypeSafe SDKs).
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest
